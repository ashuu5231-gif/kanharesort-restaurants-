# Copy this file to ".env" and fill in real values before running the server.

# Port the server runs on (Render/Railway set this automatically in production)
PORT=3000

# Password required to open the admin panel (/admin.html)
# CHANGE THIS before handing the site over or deploying it live.
ADMIN_KEY=change-this-password

# Minimum order amount enforced by the backend (in rupees)
MIN_ORDER_AMOUNT=249
